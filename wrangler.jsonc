{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "land-scout-pod",
  "main": "src/worker.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "land-scout-pod-db",
      "database_id": "456b68e6-55ce-4d41-9cc0-2fb880c004bc"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}
